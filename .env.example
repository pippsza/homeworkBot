BOT_TOKEN=your_bot_token_here
MODE=polling
WEBHOOK_URL=https://your-domain.com
PORT=3000
MONGODB_URI=mongodb://localhost:27017/homeworkbot
WEBAPP_URL=https://your-domain.com

# Важкі підсистеми. Вимкнені = бот працює як довідник (предмети, завдання,
# розклад, нагадування). Код лишається на місці, вмикається одним прапорцем.
AI_ENABLED=false
QDRANT_ENABLED=false

# Mongo вже підняте на сервері в мережі web (алiас Mongo)
# MONGODB_URI=mongodb://<user>:<pass>@Mongo:27017/homeworkbot?authSource=admin
