FROM node:20-alpine
WORKDIR /app

# resvg малює картки розкладу системними шрифтами: без цього пакета
# кирилиця перетворюється на порожні прямокутники.
# tzdata потрібна, бо розклад заданий київським часом, а образ живе в UTC:
# без неї TZ=Europe/Kyiv не діє і нагадування спізнюються на три години.
RUN apk add --no-cache font-dejavu font-noto-emoji tzdata

# Зона в образі, а не тільки в compose: оновлення котиться Watchtower'ом,
# а він переносить env запущеного контейнера і нову змінну з compose не бачить.
ENV TZ=Europe/Kyiv

COPY package*.json ./
RUN npm ci --omit=dev
COPY src/ ./src/
COPY index.ts ./
COPY tsconfig.json ./

EXPOSE 3000
CMD ["npx", "tsx", "index.ts"]
