FROM node:20-alpine
WORKDIR /app

# resvg малює картки розкладу системними шрифтами:
# без цього пакета кирилиця перетворюється на порожні прямокутники.
RUN apk add --no-cache font-dejavu font-noto-emoji

COPY package*.json ./
RUN npm ci --omit=dev
COPY src/ ./src/
COPY index.ts ./
COPY tsconfig.json ./

EXPOSE 3000
CMD ["npx", "tsx", "index.ts"]
